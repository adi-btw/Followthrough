<% content_for :title, "Forgot password" %>
<div class="auth-card">
  <h1>Forgot your password?</h1>
  <%= form_with url: passwords_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address] %>
    </div>
    <%= form.submit "Email reset instructions" %>
  <% end %>
  <p class="meta spaced"><%= link_to "Back to log in", new_session_path %></p>
</div>

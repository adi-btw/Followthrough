<% content_for :title, @care_plan.patient.name %>
<% adherence = @care_plan.adherence %>
<div class="page-head">
  <div>
    <p class="meta"><%= link_to @care_plan.patient.name, @care_plan.patient %></p>
    <h1>Care plan</h1>
    <p class="lede">Started <%= @care_plan.start_date.to_fs(:long) %>.</p>
  </div>
  <div class="actions">
    <% if @care_plan.needs_follow_up %>
      <span class="badge">Needs follow-up</span>
    <% end %>
    <%= link_to "Edit plan", edit_care_plan_path(@care_plan), class: "button secondary" %>
  </div>
</div>

<section class="card gap">
  <h2>Patient link</h2>
  <p class="meta">Share this private link. No login. It only records doses for this plan.</p>
  <label for="patient-check-in-link">Check-in link</label>
  <input id="patient-check-in-link" class="copy-link" type="text" readonly value="<%= patient_check_in_url(@care_plan.check_in_token) %>" onclick="this.select()">
</section>

<section class="card gap">
  <div class="percent">
    <%= adherence_text(adherence) %>
    <span>7-day adherence</span>
  </div>
  <p class="meta">
    <%= adherence.taken_doses %> of <%= adherence.expected_doses %> expected doses in the last 7 days.
    Each morning or evening slot marked taken counts as one dose.
  </p>
</section>

<section class="card">
  <h2>Today</h2>
  <% @care_plan.recommendations.each do |recommendation| %>
    <div class="check-row">
      <div>
        <strong><%= recommendation.name %></strong>
        <p class="meta"><%= recommendation.dose %> · <%= schedule_label(recommendation.times_per_day) %></p>
        <div class="week" aria-label="Last 7 days">
          <% ((Date.current - 6)..Date.current).each do |date| %>
            <% state, mark = day_summary(recommendation, date, @care_plan.start_date) %>
            <span class="day <%= state %>" title="<%= date.to_fs(:long) %>">
              <%= date.strftime("%a") %>
              <strong><%= mark %></strong>
            </span>
          <% end %>
        </div>
      </div>
      <%= render "recommendations/slot_buttons", recommendation: recommendation, post_url: care_plan_check_ins_path(@care_plan) %>
    </div>
  <% end %>
</section>

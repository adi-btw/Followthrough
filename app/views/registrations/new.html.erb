<% content_for :title, "Sign up" %>
<div class="auth-card">
  <h1>Create your account</h1>
  <p class="lede">You are the practitioner. Patients you add stay on this account.</p>

  <%= render "shared/errors", record: @user %>

  <%= form_with model: @user, url: registration_path do |form| %>
    <div class="field">
      <%= form.label :email_address, "Email" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username" %>
    </div>
    <div class="field">
      <%= form.label :password %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
    </div>
    <%= form.submit "Sign up" %>
  <% end %>

  <p class="meta spaced"><%= link_to "Already have an account?", new_session_path %></p>
</div>
